# Local development credentials only. Never reuse these in production.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
CORS_ORIGIN=http://localhost:5173
VITE_TOKEN_API_URL=http://localhost:3001
VITE_LIVEKIT_URL=ws://localhost:7880
VITE_MOCK_ASTERISK_URL=ws://localhost:8090/call

# Asterisk-compatible Voice Bridge demo defaults.
VOICE_BRIDGE_PORT=8091
MEDIA_START_TIMEOUT_MS=5000
AGENT_START_TIMEOUT_MS=20000
MAX_AUDIO_BUFFER_MS=500

# Local browser SIP.js demo. These values are shipped to the browser.
VITE_ASTERISK_WS_URL=ws://localhost:8088/ws
VITE_ASTERISK_DOMAIN=localhost
VITE_ASTERISK_EXTENSION=2001
VITE_ASTERISK_PASSWORD=demo2001
VITE_ASTERISK_DESTINATION=1000

# Create a key in Google AI Studio. Keep the real value only in .env.
GOOGLE_API_KEY=replace_with_your_google_ai_studio_key
